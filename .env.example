SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SCOPES=write_products,read_products,read_orders
SHOPIFY_APP_URL=https://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/bundle_builder

# Packaging low-stock alerts. Both channels are optional — with neither set,
# shortages still surface as a banner in the Packaging admin page.
RESEND_API_KEY=
PACKAGING_ALERT_FROM=packaging@yourdomain.com
SLACK_WEBHOOK_URL=
PACKAGING_ALERT_COOLDOWN_HOURS=12
